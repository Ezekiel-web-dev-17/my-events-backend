# Server Configuration
PORT=5500
NODE_ENV=development
SESSION_SECRET=your_super_secret_session_key

# Application URLs
BACKEND_URL=http://localhost:5500
FRONTEND_URL=http://localhost:5500
FRONTEND_TICKET=/dashboard/tickets
FRONTEND_STATUS_PATH=

# Database Configuration (MongoDB)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/EVENTS-DB

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Arcjet Rate Limiting & Protection
ARCJET_KEY=your_arcjet_api_key

# Redis Caching & Queue Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password

# Email & Sender Configuration
EMAIL=noreply@yourdomain.com
PASSWORD=your_email_app_password
ADMIN_EMAIL=admin@yourdomain.com
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# Cloudinary Media Storage
CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
